{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for DC Calc Tauri app",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "http:default",
    "cors-fetch:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "http://localhost:8080/**"
        },
        {
          "url": "http://localhost:8000/**"
        }
      ]
    }
  ]
}
